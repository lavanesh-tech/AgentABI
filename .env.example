# Copy to .env and fill in real values for local development.
# Never commit .env — it is gitignored.

# --- App ---
APP_NAME=AgentABI
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# --- API ---
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# --- PostgreSQL (matches docker-compose service) ---
POSTGRES_DSN=postgresql+asyncpg://agentabi:agentabi@localhost:5432/agentabi

# --- Redis ---
REDIS_DSN=redis://localhost:6379/0

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=agentabi_dev_password

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- AI providers ---
# OpenAI (Phase 8) — required only to call the explanation endpoint;
# every deterministic feature works with this empty. Never commit a
# real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
# Gemini (Phase 9) — intentionally skipped/optional, not implemented.
GEMINI_API_KEY=

# --- GitHub integration (required starting Phase 12) ---
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=

# --- JWT authentication (Security Phase A) ---
# Generate a real secret for anything beyond local dev, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Never commit a real value. Production should source this from a secrets
# manager rather than a .env file.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=agentabi
JWT_AUDIENCE=agentabi-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- GitHub OAuth2 login (Security Phase B) ---
# Register an OAuth App at https://github.com/settings/developers with
# callback URL matching GITHUB_OAUTH_REDIRECT_URI. Never commit real
# values.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
GITHUB_OAUTH_STATE_TTL_SECONDS=600

# --- API hardening (Security Phase D) ---
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true
MAX_REQUEST_BODY_BYTES=5000000
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_MUTATION_REQUESTS=30
RATE_LIMIT_MUTATION_WINDOW_SECONDS=60
RATE_LIMIT_SCAN_REPLAY_REQUESTS=10
RATE_LIMIT_SCAN_REPLAY_WINDOW_SECONDS=60
# Set to 1 only when deployed behind exactly one trusted reverse proxy
# (e.g. an ALB) that overwrites X-Forwarded-For rather than appending to it.
TRUSTED_PROXY_COUNT=0

# --- OpenTelemetry tracing (Phase 15) ---
# Off by default; AgentABI runs identically either way. Set to true only
# if you're also running `docker compose up -d otel-collector`.
OTEL_ENABLED=false

# --- Prometheus metrics (Phase 16) ---
# On by default — `/metrics` just serves a placeholder body if
# prometheus_client isn't installed, so this never breaks local dev.
METRICS_ENABLED=true
METRICS_PATH=/metrics

# --- Grafana (Phase 16, docker-compose only — not read by the API) ---
# Local-only placeholder; docker-compose.yml falls back to this exact
# value if unset. Never a real credential — change it before exposing
# Grafana beyond localhost.
GRAFANA_ADMIN_PASSWORD=agentabi_local_only
